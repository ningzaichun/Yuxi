{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuxi.local/schemas/mpp_bridge_error_v1.schema.json",
  "title": "MPP Bridge Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "tool_version", "command", "status", "occurred_at", "error", "source", "process_evidence"],
  "properties": {
    "schema_version": { "const": "mpp_bridge_error_v1" },
    "run_id": { "type": "string", "format": "uuid" },
    "tool_version": { "type": "string", "minLength": 1 },
    "command": { "const": "extract" },
    "status": { "const": "failed" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_file_name", "input_mpp_sha256_before", "input_mpp_sha256_after"],
      "properties": {
        "input_file_name": { "type": "string", "minLength": 1 },
        "input_mpp_sha256_before": { "$ref": "#/$defs/sha256" },
        "input_mpp_sha256_after": { "$ref": "#/$defs/sha256" }
      }
    },
    "process_evidence": { "$ref": "#/$defs/processEvidence" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "processEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winproj_process_ids_before", "winproj_process_ids_after_create", "winproj_process_ids_after", "residual_new_process_ids"],
      "properties": {
        "winproj_process_ids_before": { "type": "array", "items": { "type": "integer" } },
        "winproj_process_ids_after_create": { "type": "array", "items": { "type": "integer" } },
        "winproj_process_ids_after": { "type": "array", "items": { "type": "integer" } },
        "residual_new_process_ids": { "type": "array", "items": { "type": "integer" } }
      }
    }
  }
}
