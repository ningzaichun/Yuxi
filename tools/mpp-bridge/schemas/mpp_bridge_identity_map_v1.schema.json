{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuxi.local/schemas/mpp_bridge_identity_map_v1.schema.json",
  "title": "MPP Bridge Identity Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "tool_version", "source_snapshot_semantic_sha256", "output_mpp_sha256", "tasks"],
  "properties": {
    "schema_version": { "const": "mpp_bridge_identity_map_v1" },
    "run_id": { "type": "string", "format": "uuid" },
    "tool_version": { "type": "string", "minLength": 1 },
    "source_snapshot_semantic_sha256": { "$ref": "#/$defs/sha256" },
    "output_mpp_sha256": { "$ref": "#/$defs/sha256" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bridge_task_id", "source", "output"],
        "properties": {
          "bridge_task_id": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/projectIdentity" },
          "output": { "$ref": "#/$defs/projectIdentity" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "projectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unique_id"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "unique_id": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
