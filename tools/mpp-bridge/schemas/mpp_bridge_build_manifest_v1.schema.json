{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuxi.local/schemas/mpp_bridge_build_manifest_v1.schema.json",
  "title": "MPP Bridge Build Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "tool_version", "command", "status", "created_at", "source", "artifacts", "result", "process_evidence"],
  "properties": {
    "schema_version": { "const": "mpp_bridge_build_manifest_v1" },
    "run_id": { "type": "string", "format": "uuid" },
    "tool_version": { "type": "string", "minLength": 1 },
    "command": { "const": "build" },
    "status": { "const": "passed" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_file_name", "snapshot_artifact_sha256", "snapshot_semantic_sha256", "roundtrip_eligible"],
      "properties": {
        "snapshot_file_name": { "type": "string", "minLength": 1 },
        "snapshot_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_semantic_sha256": { "$ref": "#/$defs/sha256" },
        "roundtrip_eligible": { "const": true }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_mpp_file", "output_mpp_sha256", "identity_map_file", "identity_map_sha256", "build_report_file", "build_report_sha256"],
      "properties": {
        "output_mpp_file": { "type": "string", "minLength": 1 },
        "output_mpp_sha256": { "$ref": "#/$defs/sha256" },
        "identity_map_file": { "type": "string", "minLength": 1 },
        "identity_map_sha256": { "$ref": "#/$defs/sha256" },
        "build_report_file": { "type": "string", "minLength": 1 },
        "build_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendars_written", "tasks_written", "dependencies_written", "opened_after_save", "recalculated_after_reopen"],
      "properties": {
        "calendars_written": { "type": "integer", "minimum": 1 },
        "tasks_written": { "type": "integer", "minimum": 1 },
        "dependencies_written": { "type": "integer", "minimum": 0 },
        "opened_after_save": { "const": true },
        "recalculated_after_reopen": { "const": true }
      }
    },
    "process_evidence": { "$ref": "#/$defs/processEvidence" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "processEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winproj_process_ids_before", "winproj_process_ids_after_create", "winproj_process_ids_after", "residual_new_process_ids"],
      "properties": {
        "winproj_process_ids_before": { "type": "array", "items": { "type": "integer" } },
        "winproj_process_ids_after_create": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "winproj_process_ids_after": { "type": "array", "items": { "type": "integer" } },
        "residual_new_process_ids": { "type": "array", "maxItems": 0, "items": { "type": "integer" } }
      }
    }
  }
}
