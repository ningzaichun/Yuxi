{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuxi.local/schemas/mpp_bridge_manifest_v1.schema.json",
  "title": "MPP Bridge Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "tool_version", "command", "status", "created_at", "source", "artifacts", "result", "process_evidence"],
  "properties": {
    "schema_version": { "const": "mpp_bridge_manifest_v1" },
    "run_id": { "type": "string", "format": "uuid" },
    "tool_version": { "type": "string", "minLength": 1 },
    "command": { "const": "extract" },
    "status": { "const": "passed" },
    "created_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_file_name", "input_mpp_sha256_before", "input_mpp_sha256_after", "source_unchanged"],
      "properties": {
        "input_file_name": { "type": "string", "minLength": 1 },
        "input_mpp_sha256_before": { "$ref": "#/$defs/sha256" },
        "input_mpp_sha256_after": { "$ref": "#/$defs/sha256" },
        "source_unchanged": { "const": true }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_file", "snapshot_artifact_sha256", "snapshot_semantic_sha256", "original_byte_backup_file", "original_byte_backup_sha256", "working_copy_file", "working_copy_mpp_sha256"],
      "properties": {
        "snapshot_file": { "type": "string", "minLength": 1 },
        "snapshot_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "snapshot_semantic_sha256": { "$ref": "#/$defs/sha256" },
        "original_byte_backup_file": { "type": "string", "minLength": 1 },
        "original_byte_backup_sha256": { "$ref": "#/$defs/sha256" },
        "working_copy_file": { "type": "string", "minLength": 1 },
        "working_copy_mpp_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roundtrip_eligible", "unsupported_count", "blocker_count"],
      "properties": {
        "roundtrip_eligible": { "type": "boolean" },
        "unsupported_count": { "type": "integer", "minimum": 0 },
        "blocker_count": { "type": "integer", "minimum": 0 }
      }
    },
    "process_evidence": { "$ref": "#/$defs/processEvidence" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "processEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["winproj_process_ids_before", "winproj_process_ids_after_create", "winproj_process_ids_after", "residual_new_process_ids"],
      "properties": {
        "winproj_process_ids_before": { "type": "array", "items": { "type": "integer" } },
        "winproj_process_ids_after_create": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "winproj_process_ids_after": { "type": "array", "items": { "type": "integer" } },
        "residual_new_process_ids": { "type": "array", "maxItems": 0, "items": { "type": "integer" } }
      }
    }
  }
}
